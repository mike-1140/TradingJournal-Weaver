# .env.example — Vorlage fuer lokale Konfiguration
# Kopieren als ".env" und mit eigenen Werten befuellen

DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306

DB_NAME_MONEY=ibkr_money
DB_NAME_SIM=ibkr_paper

TABLE_TRADES_RAW=trades_raw
TABLE_TRADES_SUMMARY=trades_summary
TABLE_TRADES_OPEN=trades_open
TABLE_TRADES_CLOSE=trades_close
TABLE_TRADES_FX=trades_fx
TABLE_SYMBOLS=symbols
TABLE_CAMPAIGN_LEDGER=campaign_ledger
TABLE_TRADING_CAMPAIGNS=trading_campaigns

# Optionaler Tabellen-Prefix (z.B. "mike_")
TABLE_PREFIX = "mike_"

DEBUG_SQL = "false"

# IMAP Email-Account fuer FlexQuery-Mails
IMAP_USERNAME=deine@email.at
IMAP_PASSWORD=
IMAP_SERVER=imap.gmx.com

# IBKR FlexQuery API (Alternative zu E-Mail-Abruf)
# Token: IBKR Portal → Settings → Account Settings → Flex Web Service → Create/View Token
# Query-IDs: IBKR Portal → Reports → Flex Queries → ID in der Liste
#
# Format: kommagetrennte "token:query_id" Paare — ein Paar pro FlexQuery
# Selbes Login (money + paper):  IBKR_FLEX_QUERIES=TOKEN1:111111,TOKEN1:222222
# Verschiedene Logins:            IBKR_FLEX_QUERIES=TOKEN1:111111,TOKEN2:333333
# Das Routing zum Environment erfolgt automatisch über die accountId im XML (ACCOUNT_MAP)
IBKR_FLEX_QUERIES=
