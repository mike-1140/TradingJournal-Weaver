# .env.example — Vorlage fuer lokale Konfiguration
# Kopieren als ".env" und mit eigenen Werten befuellen

DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306

DB_NAME_MONEY=ibkr_money
DB_NAME_PAPER=ibkr_paper
DB_NAME_TEST=ibkr_test
DB_NAME_AUTOM_MONEY=ibkr_autom_money
DB_NAME_AUTOM_PAPER=ibkr_autom_paper

TABLE_TRADES_RAW=trades_raw
TABLE_TRADES_OPEN=trades_open
TABLE_TRADES_CLOSE=trades_close
TABLE_TRADES_FX=trades_fx
TABLE_SYMBOLS=symbols
TABLE_CAMPAIGN_LEDGER=campaign_ledger
TABLE_TRADING_CAMPAIGNS=trading_campaigns

# Tabellen-Prefix: entweder per Usernamen (empfohlen, Prefix kommt aus users.toml)...
DEFAULT_USER=mike
# ...oder direkt der Prefix-String (Override, gewinnt falls beides gesetzt ist):
# TABLE_PREFIX="mike_"

DEBUG_SQL="false"

# Kampagnen: so viele Tage bleibt eine glattgestellte Kampagne PENDING, bevor sie CLOSED wird
# (ein neuer Trade im selben Symbol innerhalb dieser Frist setzt sie fort). Standard 10,
# empfohlen 7-14. Aenderung wirkt nur auf kuenftige Verarbeitung, bestehende Kampagnen erst
# nach einem Neuaufbau (reset_IBKR_DB + --from-summary).
# MAX_GAP_DAYS=10

# Ablageordner fuer die IBKR-Berichte (XML bzw. Kontoauszug-CSV). Ohne Eintrag:
# Windows C:\Trade_XML und C:\Trade_CSV, Linux/macOS ~/Trade_XML und ~/Trade_CSV.
# Alle Unterordner (incoming_mail, incoming_api, <environment>\<benutzer>\processed, ...)
# werden darunter angelegt. ~ und Umgebungsvariablen werden aufgeloest.
# TRADE_XML_DIR=C:\Trade_XML
# TRADE_CSV_DIR=C:\Trade_CSV

# Pipeline-Schritt "enrich" (optional): Delta/IV/IVR/IVP fuer Options-Trades ueber die TWS-API.
# Nur lesend; TWS bzw. IB Gateway muss laufen (Konfiguration -> API -> Einstellungen:
# "ActiveX- und Socket-Clients aktivieren"). Ohne Eintrag gelten diese Werte:
# TWS_HOST=127.0.0.1
# TWS_PORT=7497          # 7497 = Papierkonto, 7496 = Echtgeld
# TWS_CLIENT_ID=630      # eigene Nummer, darf von keiner anderen TWS-Anwendung genutzt werden
# GREEKS_RATE=0.04       # risikofreier Zins fuer Black-Scholes
# GREEKS_TRADE_TZ=America/New_York   # Zeitzone der Ausfuehrungszeiten in der Flex Query

# IMAP Email-Account fuer FlexQuery-Mails
IMAP_USERNAME=deine@email.at
IMAP_PASSWORD=
IMAP_SERVER=imap.gmx.com

# Betreff-Filter der IBKR Activity Statement E-Mails (Substring-Suche)
IBKR_ACTIVITY_SUBJECT=Activity Statement
IBKR_ACTIVITY_SUBJECT_DE=Kontoauszug

# IBKR FlexQuery Web-API (get_flexquery_api.py) — zweiter, gleichwertiger Import-Kanal
# neben den Mails (kein reiner Verifikationskanal). Ohne Eintrag hier ist der Schritt ein
# No-Op (kein Fehler). On-demand generiert, kein festes Tages-Zeitfenster noetig.
# Token: IBKR Portal → Settings → Account Settings → Flex Web Service → Create/View Token
# Query-IDs: IBKR Portal → Reports → Flex Queries → ID in der Liste
#
# Format: kommagetrennte "token:query_id" Paare — ein Paar pro FlexQuery
# Selbes Login (money + paper):  IBKR_FLEX_QUERIES=TOKEN1:111111,TOKEN1:222222
# Verschiedene Logins:            IBKR_FLEX_QUERIES=TOKEN1:111111,TOKEN2:333333
# Das Routing zum Environment erfolgt automatisch über die accountId im XML (accounts.toml)
IBKR_FLEX_QUERIES=
